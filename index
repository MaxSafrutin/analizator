<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2300d4ff'%3E%3Cpath d='M12 2a1 1 0 0 1 1 1v1.075A7.003 7.003 0 0 1 19 11v1h1a1 1 0 1 1 0 2h-1.075a7.002 7.002 0 0 1-5.925 5.925V20h2a1 1 0 1 1 0 2H9a1 1 0 1 1 0-2h2v-1.075A7.002 7.002 0 0 1 5 13H3.925a1 1 0 1 1 0-2H5v-1a7.003 7.003 0 0 1 6-6.925V3a1 1 0 0 1 1-1zm6 10a5 5 0 0 0-4.9-4.1 5 5 0 0 0-4.1 4.1h9z'/%3E%3C/svg%3E">
    <link rel="alternate icon" type="image/png" href="https://img.icons8.com/ios-filled/50/00d4ff/scales.png">
    <link rel="apple-touch-icon" href="https://img.icons8.com/ios-filled/180/00d4ff/scales.png">

    <title>Анализатор</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #1a1a2e;
            --card-bg: #111122;
            --card-border: rgba(255, 255, 255, 0.06);
            --text-main: #e6e6e6;
            --text-muted: #8e8e93;
            --accent-primary: #4d4dff;
            --accent-cyan: #00d4ff;
            --color-plus: #30d158;
            --color-minus: #ff453a;
            --radius: 12px;
            --transition: all 0.2s ease;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding: 16px;
            overflow-x: hidden;
            position: relative;
        }

        .snow-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        .snowflake {
            position: absolute;
            top: -10px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            pointer-events: none;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 0.6; }
            90% { opacity: 0.6; }
            100% { transform: translateY(105vh) translateX(40px); opacity: 0; }
        }

        .app-container {
            position: relative;
            z-index: 2;
            max-width: 1200px;
            margin: 0 auto;
            padding-bottom: 60px;
        }

        header {
            text-align: center;
            margin-bottom: 24px;
            padding: 10px 0;
        }

        header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #ffffff, var(--accent-cyan));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .global-settings {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            padding: 16px;
            margin-bottom: 24px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }

        @media (min-width: 768px) {
            .global-settings {
                grid-template-columns: 1fr 1fr;
            }
        }

        .setting-block {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .setting-comment {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .segmented-control {
            display: flex;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--card-border);
            padding: 3px;
            border-radius: 10px;
            width: 100%;
        }

        .segment-btn {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 7px;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
        }

        .segment-btn.active.mode-accent {
            background: var(--accent-primary);
            color: #ffffff;
        }

        .variants-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        @media (min-width: 850px) {
            .variants-grid.compare-mode {
                grid-template-columns: 1fr 1fr;
            }
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            transition: var(--transition);
        }

        .card-header-toggle {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding-bottom: 10px;
            margin-bottom: 16px;
        }

        @media (max-width: 768px) {
            .card-header-toggle {
                cursor: pointer;
            }
            .card-header-toggle::after {
                content: '▼';
                font-size: 0.8rem;
                color: var(--text-muted);
                transition: transform 0.2s;
            }
            .card.collapsed .card-header-toggle::after {
                transform: rotate(-90deg);
            }
            .card.collapsed .card-body-content {
                display: none !important;
            }
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--accent-cyan);
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .accordion-trigger {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            padding: 12px 0;
            user-select: none;
        }
        
        .accordion-trigger::after {
            content: '▼';
            font-size: 0.8rem;
            color: var(--text-muted);
            transition: transform 0.2s;
        }

        .accordion-block.collapsed .accordion-trigger::after {
            transform: rotate(-90deg);
        }

        .accordion-content {
            display: block;
            padding-top: 8px;
        }

        .accordion-block.collapsed .accordion-content {
            display: none;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            font-weight: 500;
        }

        input, textarea {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 12px;
            color: var(--text-main);
            font-size: 0.95rem;
            outline: none;
            transition: var(--transition);
        }

        input:focus, textarea:focus {
            border-color: var(--accent-cyan);
            background: rgba(255, 255, 255, 0.07);
        }

        .criteria-list {
            margin-top: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .criteria-header-labels {
            display: grid;
            grid-template-columns: 1fr 110px 90px 44px;
            gap: 10px;
            margin-bottom: -4px;
        }

        .criteria-header-labels label { margin-bottom: 0; }

        .criteria-item {
            display: grid;
            grid-template-columns: 1fr 110px 90px 44px;
            gap: 10px;
            align-items: center;
            animation: fadeIn 0.2s ease;
        }

        @media (max-width: 600px) {
            .criteria-header-labels { display: none; }
            .criteria-item {
                grid-template-columns: 1fr 1fr;
                background: rgba(255,255,255,0.02);
                padding: 12px;
                border-radius: 8px;
                border: 1px solid var(--card-border);
                gap: 8px;
            }
            .criteria-item .crit-name { grid-column: span 2; }
            .criteria-item .btn-delete-row { grid-column: span 2; width: 100%; margin-top: 4px; }
        }

        .type-toggle {
            display: flex;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--card-border);
            border-radius: 8px;
            padding: 2px;
            height: 45px;
        }

        .type-btn {
            flex: 1;
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: 6px;
            color: var(--text-muted);
            transition: var(--transition);
        }

        .type-btn.minus.active { background: rgba(255, 69, 58, 0.15); color: var(--color-minus); }
        .type-btn.plus.active { background: rgba(48, 209, 88, 0.15); color: var(--color-plus); }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 12px 20px;
            font-size: 0.95rem;
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            gap: 8px;
            width: 100%;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
            border: 1px solid var(--card-border);
        }

        .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); }
        .btn-primary { background: var(--accent-primary); color: #ffffff; }
        .btn-primary:hover { background: #3a3aff; }

        .btn-delete-row {
            background: rgba(255, 69, 58, 0.08);
            color: var(--color-minus);
            border: 1px solid rgba(255, 69, 58, 0.15);
            height: 45px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .btn-delete-row:hover { background: rgba(255, 69, 58, 0.2); }

        .actions-panel {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-top: 24px;
        }

        @media (min-width: 600px) { .actions-panel { grid-template-columns: 2fr 1fr; } }

        .results-section {
            margin-top: 32px;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .winner-banner {
            background: linear-gradient(135deg, rgba(77, 77, 255, 0.12), rgba(0, 212, 255, 0.12));
            border: 1px solid var(--accent-cyan);
            border-radius: var(--radius);
            padding: 20px;
            text-align: center;
            margin-bottom: 24px;
        }

        .winner-title { font-size: 1.3rem; font-weight: 700; color: var(--accent-cyan); margin-bottom: 4px; }

        .comparison-bars-container {
            margin: 20px 0;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            padding: 16px;
        }
        .comparison-bars-title {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 16px;
            text-align: center;
        }
        .comparison-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }
        @media (min-width: 768px) {
            .comparison-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        .bar-item-wrapper {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .bar-label-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            font-weight: 500;
        }
        .outer-progress-bar {
            width: 100%;
            height: 28px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.08);
            position: relative;
        }
        .inner-relative-fill {
            height: 100%;
            width: 0%;
            transition: width 0.5s ease;
            display: flex;
            overflow: hidden;
            position: relative;
        }
        .sub-bar-minus {
            height: 100%;
            background-color: var(--color-minus);
            transition: width 0.3s;
            position: relative;
        }
        .sub-bar-plus {
            height: 100%;
            background-color: var(--color-plus);
            transition: width 0.3s;
            position: relative;
        }
        
        .bar-text-left-minus {
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.8rem;
            font-weight: 600;
            color: #ffffff;
            z-index: 6;
            pointer-events: none;
            white-space: nowrap;
        }

        .bar-text-left-plus {
            position: absolute;
            left: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.8rem;
            font-weight: 600;
            color: #ffffff;
            z-index: 6;
            pointer-events: none;
            white-space: nowrap;
        }

        .bar-score-overlay {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.85rem;
            font-weight: 700;
            color: #ffffff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
            z-index: 5;
        }
        .bar-commentary {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.3;
        }
        .bar-recommendation {
            font-size: 0.8rem;
            color: var(--accent-cyan);
            margin-top: 2px;
            font-weight: 500;
        }

        .results-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }

        @media (min-width: 850px) {
            .results-grid.compare-mode { grid-template-columns: 1fr 1fr; }
            .results-grid.single-mode { grid-template-columns: 1fr; }
        }

        .index-badge-container {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 8px 16px;
            border-radius: 30px;
            margin-top: 8px;
        }

        .index-label { font-size: 0.85rem; color: var(--text-muted); margin-right: 10px; font-weight: 500; }
        .index-value { font-size: 1.4rem; font-weight: 700; color: #ffffff; }

        .summary-list { margin-top: 12px; list-style: none; }
        .summary-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); font-size: 0.9rem; }

        .badge { padding: 4px 8px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; }
        .badge-plus { background: rgba(48, 209, 88, 0.12); color: var(--color-plus); }
        .badge-minus { background: rgba(255, 69, 58, 0.12); color: var(--color-minus); }

        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0; pointer-events: none;
            transition: opacity 0.2s ease;
        }
        .modal-overlay.show { opacity: 1; pointer-events: auto; }
        .modal-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            padding: 20px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        }
        .modal-card textarea {
            height: 150px;
            margin-bottom: 16px;
            resize: none;
        }
        .modal-buttons {
            display: flex;
            gap: 12px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .toast {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--accent-cyan);
            color: #000;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 999;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 25px rgba(0, 212, 255, 0.3);
        }

        .toast.show { transform: translateX(-50%) translateY(0); }
    </style>
</head>
<body>

    <div class="snow-container" id="snowContainer"></div>

    <div class="app-container">
        <header>
            <h1>Анализатор</h1>
        </header>

        <div class="global-settings">
            <div class="setting-block">
                <label>Режим работы</label>
                <div class="segmented-control">
                    <button class="segment-btn active mode-accent" id="btnSingleMode" onclick="setMode('single')">Один вариант</button>
                    <button class="segment-btn mode-accent" id="btnCompareMode" onclick="setMode('compare')">Сравнение вариантов</button>
                </div>
            </div>
            <div class="setting-block">
                <label>Метод расчета стоимости</label>
                <div class="segmented-control" style="margin-bottom: 6px;">
                    <button class="segment-btn active mode-accent" id="globalMethodA" onclick="setCalculationMethod('A')">Сумма баллов</button>
                    <button class="segment-btn mode-accent" id="globalMethodB" onclick="setCalculationMethod('B')">Баллы / Цена</button>
                </div>
                <div class="segmented-control" id="strategyToggleContainer" style="display: none; animation: fadeIn 0.2s ease;">
                    <button class="segment-btn active mode-accent" id="stratDiscount" onclick="setStrategyMode('discount')">Скидка</button>
                    <button class="segment-btn mode-accent" id="stratMarkup" onclick="setStrategyMode('markup')">Цена (Наценка)</button>
                </div>
                <div class="setting-comment">Обнаруженный пиковый вес в критериях: <span id="globalMaxWeightDisplay">0</span></div>
            </div>
        </div>

        <div class="variants-grid" id="variantsGrid">
            
            <div class="card" id="cardV1">
                <div class="card-header-toggle" onclick="toggleMobileCard('cardV1')">
                    <div class="card-title"><span id="v1Label">Параметры анализа</span></div>
                </div>
                
                <div class="card-body-content">
                    <div class="form-group">
                        <label>Название анализа</label>
                        <input type="text" id="v1Name" value="Вариант 1">
                    </div>

                    <div class="form-group">
                        <button class="btn btn-secondary" onclick="openSmartPasteModal('v1')">⚡ Умное распределение списка</button>
                    </div>

                    <div class="form-group" id="v1PriceGroup" style="display: none; animation: fadeIn 0.2s ease;">
                        <label>Цена</label>
                        <input type="number" id="v1Price" value="2000000" min="1">
                    </div>

                    <h4 style="margin: 20px 0 10px 0; font-size: 0.9rem; font-weight: 600; color: var(--text-muted);">Критерии</h4>
                    
                    <div class="criteria-header-labels">
                        <label>Название критерия</label>
                        <label style="text-align: center;">Тип</label>
                        <label>Вес</label>
                        <div></div>
                    </div>

                    <div class="criteria-list" id="v1CriteriaList"></div>

                    <button class="btn btn-secondary" style="margin-top: 14px;" onclick="addCriteriaRow('v1')">
                        + Добавить критерий
                    </button>
                </div>
            </div>

            <div class="card" id="cardV2" style="display: none;">
                <div class="card-header-toggle" onclick="toggleMobileCard('cardV2')">
                    <div class="card-title"><span>Второй вариант</span></div>
                </div>
                
                <div class="card-body-content">
                    <div class="form-group">
                        <label>Название анализа</label>
                        <input type="text" id="v2Name" value="Вариант 2">
                    </div>

                    <div class="form-group">
                        <button class="btn btn-secondary" onclick="openSmartPasteModal('v2')">⚡ Умное распределение списка</button>
                    </div>

                    <div class="form-group" id="v2PriceGroup" style="display: none; animation: fadeIn 0.2s ease;">
                        <label>Цена</label>
                        <input type="number" id="v2Price" value="2500000" min="1">
                    </div>

                    <h4 style="margin: 20px 0 10px 0; font-size: 0.9rem; font-weight: 600; color: var(--text-muted);">Критерии</h4>
                    
                    <div class="criteria-header-labels">
                        <label>Название критерия</label>
                        <label style="text-align: center;">Тип</label>
                        <label>Вес</label>
                        <div></div>
                    </div>

                    <div class="criteria-list" id="v2CriteriaList"></div>

                    <button class="btn btn-secondary" style="margin-top: 14px;" onclick="addCriteriaRow('v2')">
                        + Добавить критерий
                    </button>
                </div>
            </div>

        </div>

        <div class="actions-panel">
            <button class="btn btn-primary" onclick="calculateResults()">Сформировать отчет</button>
            <button class="btn btn-secondary" onclick="resetAll(true)">Очистить всё</button>
        </div>

        <div class="results-section" id="resultsSection">
            
            <div class="winner-banner" id="winnerBanner" style="display: none;">
                <div class="winner-title" id="winnerTitle">Фаворит</div>
                <p id="winnerReason" style="font-size: 0.95rem; color: var(--text-main); margin-bottom: 8px;"></p>
            </div>

            <div class="comparison-bars-container" id="comparisonBarsContainer" style="display: none;">
                <div class="comparison-bars-title" id="comparisonBarsTitle">Сравнение вариантов эффективности</div>
                <div class="comparison-grid" id="comparisonBarsGrid"></div>
            </div>

            <div class="results-grid" id="resultsGridConfig">
                
                <div class="card accordion-block" id="resultCardV1">
                    <div class="accordion-trigger" onclick="toggleAccordion('resultCardV1')">
                        <h3 class="card-title" id="resNameV1">Результаты</h3>
                    </div>
                    
                    <div class="accordion-content">
                        <div class="index-badge-container">
                            <span class="index-label" id="indexLabelV1">Индекс:</span>
                            <span class="index-value" id="resScoreV1">0</span>
                        </div>
                        <ul class="summary-list" id="resListV1"></ul>
                    </div>
                </div>

                <div class="card accordion-block" id="resultCardV2" style="display: none;">
                    <div class="accordion-trigger" onclick="toggleAccordion('resultCardV2')">
                        <h3 class="card-title" id="resNameV2">Результаты</h3>
                    </div>
                    
                    <div class="accordion-content">
                        <div class="index-badge-container">
                            <span class="index-label" id="indexLabelV2">Индекс:</span>
                            <span class="index-value" id="resScoreV2">0</span>
                        </div>
                        <ul class="summary-list" id="resListV2"></ul>
                    </div>
                </div>

            </div>

            <button class="btn btn-primary" style="background: #00d4ff; color: #000; font-weight: 600; margin-top: 24px;" onclick="copyToClipboard()">
                Копировать результат для мессенджеров
            </button>
        </div>

    </div>

    <div class="modal-overlay" id="smartPasteModal">
        <div class="modal-card">
            <h3 style="margin-bottom: 12px; font-size: 1.1rem; color: var(--accent-cyan);">Умное распределение списка</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">Вставьте строки и баллы вида:<br>Название критерия<br>+5 или -3</p>
            <textarea id="modalTextarea" placeholder="Вставьте текст сюда..."></textarea>
            <div class="modal-buttons">
                <button class="btn btn-primary" onclick="confirmSmartPaste()">Распределить</button>
                <button class="btn btn-secondary" onclick="closeSmartPasteModal()">Отмена</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast">Результат скопирован!</div>

    <script>
        let currentMode = 'single';
        let selectedMethod = 'A';
        let selectedStrategy = 'discount'; 
        let activeSmartPastePrefix = 'v1';

        function createSnow() {
            const container = document.getElementById('snowContainer');
            const flakeCount = 20;
            for (let i = 0; i < flakeCount; i++) {
                let flake = document.createElement('div');
                flake.className = 'snowflake';
                flake.style.left = Math.random() * 100 + 'vw';
                flake.style.animationDuration = (Math.random() * 4 + 6) + 's';
                flake.style.animationDelay = Math.random() * 5 + 's';
                let size = Math.random() * 2.5 + 1.5;
                flake.style.width = size + 'px';
                flake.style.height = size + 'px';
                container.appendChild(flake);
            }
        }

        function setMode(mode) {
            currentMode = mode;
            const grid = document.getElementById('variantsGrid');
            const cardV2 = document.getElementById('cardV2');
            const v1Label = document.getElementById('v1Label');
            const resGridConfig = document.getElementById('resultsGridConfig');
            
            document.getElementById('btnSingleMode').classList.toggle('active', mode === 'single');
            document.getElementById('btnCompareMode').classList.toggle('active', mode === 'compare');

            if (mode === 'compare') {
                grid.classList.add('compare-mode');
                cardV2.style.display = 'block';
                v1Label.textContent = 'Первый вариант';
                resGridConfig.className = 'results-grid compare-mode';
            } else {
                grid.classList.remove('compare-mode');
                cardV2.style.display = 'none';
                v1Label.textContent = 'Параметры анализа';
                resGridConfig.className = 'results-grid single-mode';
            }
            updateGlobalMaxWeight();
            document.getElementById('resultsSection').style.display = 'none';
            saveToStorage();
        }

        function setCalculationMethod(method) {
            selectedMethod = method;
            document.getElementById('globalMethodA').classList.toggle('active', method === 'A');
            document.getElementById('globalMethodB').classList.toggle('active', method === 'B');
            
            const displayStyle = method === 'B' ? 'block' : 'none';
            document.getElementById('v1PriceGroup').style.display = displayStyle;
            document.getElementById('v2PriceGroup').style.display = displayStyle;
            document.getElementById('strategyToggleContainer').style.display = displayStyle;
            
            saveToStorage();
        }

        function setStrategyMode(strategy) {
            selectedStrategy = strategy;
            document.getElementById('stratDiscount').classList.toggle('active', strategy === 'discount');
            document.getElementById('stratMarkup').classList.toggle('active', strategy === 'markup');
            saveToStorage();
        }

        function updateGlobalMaxWeight() {
            let maxWeight = 0;
            const weightInputs = document.querySelectorAll('.crit-weight');
            weightInputs.forEach(input => {
                const val = parseFloat(input.value) || 0;
                if (val > maxWeight) maxWeight = val;
            });
            document.getElementById('globalMaxWeightDisplay').textContent = maxWeight;
            return maxWeight;
        }

        function toggleMobileCard(cardId) {
            if (window.innerWidth <= 768) {
                document.getElementById(cardId).classList.toggle('collapsed');
            }
        }

        function toggleAccordion(blockId) {
            document.getElementById(blockId).classList.toggle('collapsed');
        }

        function openSmartPasteModal(prefix) {
            activeSmartPastePrefix = prefix;
            document.getElementById('modalTextarea').value = '';
            document.getElementById('smartPasteModal').classList.add('show');
            document.getElementById('modalTextarea').focus();
        }

        function closeSmartPasteModal() {
            document.getElementById('smartPasteModal').classList.remove('show');
        }

        function confirmSmartPaste() {
            const textarea = document.getElementById('modalTextarea');
            const rawText = textarea.value.trim();
            if (!rawText) {
                closeSmartPasteModal();
                return;
            }

            document.getElementById(`${activeSmartPastePrefix}CriteriaList`).innerHTML = '';

            let lines = rawText.split('\n')
                .map(l => l.replace(/[\[\]]/g, '').trim())
                .filter(l => l.length > 0);

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i];
                if (/^[+-]?\d+$/.test(line)) continue; 

                let criteriaName = line;
                let criteriaType = 'plus';
                let criteriaWeight = '';

                if (i + 1 < lines.length && /^[+-]?\d+$/.test(lines[i + 1])) {
                    let nextLine = lines[i + 1];
                    if (nextLine.startsWith('-')) {
                        criteriaType = 'minus';
                    } else {
                        criteriaType = 'plus';
                    }
                    criteriaWeight = nextLine.replace(/[+-]/g, '');
                    i++; 
                }

                addCriteriaRow(activeSmartPastePrefix, criteriaName, criteriaType, criteriaWeight);
            }
            
            closeSmartPasteModal();
            updateGlobalMaxWeight();
            saveToStorage();
        }

        function addCriteriaRow(variantPrefix, name = '', type = 'plus', weight = '') {
            const container = document.getElementById(`${variantPrefix}CriteriaList`);
            const rowId = 'row_' + Date.now() + Math.random().toString(36).substr(2, 5);

            const item = document.createElement('div');
            item.className = 'criteria-item';
            item.id = rowId;

            item.innerHTML = `
                <input type="text" placeholder="Название критерия (Enter)" class="crit-name" value="${name}">
                <div class="type-toggle">
                    <button class="type-btn minus ${type === 'minus' ? 'active' : ''}" onclick="toggleRowType('${rowId}', 'minus')">Минус</button>
                    <button class="type-btn plus ${type === 'plus' ? 'active' : ''}" onclick="toggleRowType('${rowId}', 'plus')">Плюс</button>
                </div>
                <input type="number" placeholder="Вес" class="crit-weight" value="${weight}" min="0">
                <button class="btn-delete-row" onclick="document.getElementById('${rowId}').remove(); updateGlobalMaxWeight(); saveToStorage();">✕</button>
            `;

            container.appendChild(item);

            const weightInput = item.querySelector('.crit-weight');
            weightInput.addEventListener('input', () => { updateGlobalMaxWeight(); saveToStorage(); });

            const nameInput = item.querySelector('.crit-name');
            nameInput.addEventListener('input', saveToStorage);
            nameInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addCriteriaRow(variantPrefix);
                    setTimeout(() => {
                        const nextRows = container.querySelectorAll('.crit-name');
                        if(nextRows.length > 0) nextRows[nextRows.length - 1].focus();
                    }, 50);
                }
            });
            
            updateGlobalMaxWeight();
            saveToStorage();
        }

        function toggleRowType(rowId, type) {
            const row = document.getElementById(rowId);
            const btnPlus = row.querySelector('.type-btn.plus');
            const btnMinus = row.querySelector('.type-btn.minus');
            if (type === 'plus') {
                btnPlus.classList.add('active');
                btnMinus.classList.remove('active');
            } else {
                btnMinus.classList.add('active');
                btnPlus.classList.remove('active');
            }
            saveToStorage();
        }

        function getVariantData(prefix, globalMax) {
            const name = document.getElementById(`${prefix}Name`).value || (prefix === 'v1' ? 'Вариант 1' : 'Вариант 2');
            const price = parseFloat(document.getElementById(`${prefix}Price`).value) || 1;
            const rows = document.querySelectorAll(`#${prefix}CriteriaList .criteria-item`);
            
            let criteria = [];
            let sumPlus = 0;
            let sumMinus = 0;

            rows.forEach(row => {
                const cName = row.querySelector('.crit-name').value || 'Безымянный критерий';
                const isPlus = row.querySelector('.type-btn.plus').classList.contains('active');
                const cType = isPlus ? 'plus' : 'minus';
                let cWeight = parseFloat(row.querySelector('.crit-weight').value) || 0;

                if (cType === 'plus') {
                    sumPlus += cWeight;
                } else {
                    sumMinus += cWeight;
                }

                criteria.push({ name: cName, type: cType, weight: cWeight });
            });

            let baseBalance = sumPlus - sumMinus;
            let finalScore = 0;

            if (selectedMethod === 'B') {
                if (selectedStrategy === 'discount') {
                    // Логика Скидки: Чем цена ВЫШЕ, тем МЕНЬШЕ ценность балла.
                    if (price > 0) finalScore = (baseBalance / price) * 1000000;
                } else {
                    // Логика Наценки (Прежний вариант): Чем цена ВЫШЕ, тем ВЫШЕ ценность балла (прямое умножение)
                    finalScore = baseBalance * price / 100000;
                }
            } else {
                finalScore = baseBalance;
            }

            return { name, price, method: selectedMethod, strategy: selectedStrategy, criteria, sumPlus, sumMinus, baseBalance, finalScore };
        }

        function formatScore(score, method) {
            if (method === 'B') {
                return score.toFixed(2) + ' ед. ценности';
            }
            return score.toLocaleString('ru-RU');
        }

        function calculateResults() {
            const globalMax = updateGlobalMaxWeight();
            const v1 = getVariantData('v1', globalMax);
            
            document.getElementById('resultsSection').style.display = 'block';
            
            // Автоматическое сворачивание итоговых списков вариантов в аккордеоны (Пункт 1)
            document.getElementById('resultCardV1').classList.add('collapsed');
            document.getElementById('resultCardV2').classList.add('collapsed');
            
            const labelV1 = document.getElementById('indexLabelV1');
            
            if (currentMode === 'single') {
                labelV1.textContent = selectedMethod === 'B' ? "Оценка ценности:" : "Баланс баллов:";
                
                document.getElementById('resNameV1').textContent = `${v1.name} (Развернуть список)`;
                document.getElementById('resScoreV1').textContent = formatScore(v1.finalScore, v1.method);
                renderSummaryList('resListV1', v1.criteria);
                
                document.getElementById('resultCardV2').style.display = 'none';
                
                // Для одиночного режима теперь тоже генерируем красивый блок баров и баннер (Пункт 3)
                document.getElementById('winnerBanner').style.display = 'block';
                document.getElementById('comparisonBarsContainer').style.display = 'block';
                
                const bannerTitle = document.getElementById('winnerTitle');
                const bannerReason = document.getElementById('winnerReason');
                
                bannerTitle.textContent = `📊 Анализ объекта: ${v1.name}`;
                if (selectedMethod === 'A') {
                    let total = v1.sumPlus + v1.sumMinus;
                    let pPct = total > 0 ? Math.round((v1.sumPlus / total) * 100) : 100;
                    bannerReason.textContent = `Общий баланс составляет ${v1.baseBalance} баллов. Плюсы составляют ${pPct}% от всей массы критериев.`;
                } else {
                    bannerReason.textContent = `Объект обработан по методу "${selectedStrategy === 'discount' ? 'Скидка' : 'Наценка'}" с результатом эффективности ${v1.finalScore.toFixed(2)}.`;
                }

                // В одиночном режиме бар строит соотношение плюсов и минусов самого себя
                let maxScore = Math.max(v1.sumPlus, v1.sumMinus);
                if (maxScore <= 0) maxScore = 1;
                let plusPct = (v1.sumPlus / maxScore) * 100;
                let minusPct = (v1.sumMinus / maxScore) * 100;
                
                const barTitleEl = document.getElementById('comparisonBarsTitle');
                if (v1.sumPlus >= v1.sumMinus) {
                    let diff = v1.sumMinus > 0 ? Math.round(((v1.sumPlus - v1.sumMinus)/v1.sumMinus)*100) : 100;
                    barTitleEl.textContent = `Соотношение аргументов: Плюсы превосходят Минусы на ${diff}%`;
                } else {
                    let diff = v1.sumPlus > 0 ? Math.round(((v1.sumMinus - v1.sumPlus)/v1.sumPlus)*100) : 100;
                    barTitleEl.textContent = `Соотношение аргументов: Минусы превосходят Плюсы на ${diff}%`;
                }

                renderSingleProgressBar('comparisonBarsGrid', v1, plusPct, minusPct);

            } else {
                const v2 = getVariantData('v2', globalMax);
                
                labelV1.textContent = selectedMethod === 'B' ? "Индекс ценности:" : "Итог:";
                document.getElementById('indexLabelV2').textContent = selectedMethod === 'B' ? "Индекс ценности:" : "Итог:";

                document.getElementById('resNameV1').textContent = `${v1.name} (Развернуть список)`;
                document.getElementById('resScoreV1').textContent = formatScore(v1.finalScore, v1.method);
                renderSummaryList('resListV1', v1.criteria);

                document.getElementById('resultCardV2').style.display = 'block';
                document.getElementById('resNameV2').textContent = `${v2.name} (Развернуть список)`;
                document.getElementById('resScoreV2').textContent = formatScore(v2.finalScore, v2.method);
                renderSummaryList('resListV2', v2.criteria);
                
                document.getElementById('winnerBanner').style.display = 'block';
                document.getElementById('comparisonBarsContainer').style.display = 'block';
                
                const bannerTitle = document.getElementById('winnerTitle');
                const bannerReason = document.getElementById('winnerReason');

                let winner = null;
                let loser = null;

                if (v1.finalScore > v2.finalScore) {
                    winner = v1; loser = v2;
                    bannerTitle.textContent = `🏆 Рекомендуется: ${v1.name}`;
                    bannerReason.textContent = `Вариант лидирует по уровню расчетной эффективности.`;
                } else if (v2.finalScore > v1.finalScore) {
                    winner = v2; loser = v1;
                    bannerTitle.textContent = `🏆 Рекомендуется: ${v2.name}`;
                    bannerReason.textContent = `Объект опережает конкурента по уровню расчетной эффективности.`;
                } else {
                    bannerTitle.textContent = `⚖️ Равнозначные варианты`;
                    bannerReason.textContent = `Математическая ценность сравниваемых объектов полностью идентична.`;
                }

                let maxScore = Math.max(v1.finalScore, v2.finalScore);
                if (maxScore <= 0) maxScore = 1;
                
                let v1PctOfMax = (v1.finalScore / maxScore) * 100;
                let v2PctOfMax = (v2.finalScore / maxScore) * 100;
                if(v1PctOfMax < 0) v1PctOfMax = 0;
                if(v2PctOfMax < 0) v2PctOfMax = 0;

                let diffPercent = 0;
                if (loser && loser.finalScore !== 0) {
                    diffPercent = Math.round(((winner.finalScore - loser.finalScore) / Math.abs(loser.finalScore)) * 100);
                } else if (winner && loser && loser.finalScore === 0 && winner.finalScore > 0) {
                    diffPercent = 100;
                }
                
                const barTitleEl = document.getElementById('comparisonBarsTitle');
                if (winner && loser && v1.finalScore !== v2.finalScore) {
                    barTitleEl.textContent = `Анализ: ${winner.name} эффективнее, чем ${loser.name} на ${diffPercent}%`;
                } else {
                    barTitleEl.textContent = `Сравнение вариантов эффективности (Варианты равны)`;
                }

                renderComplexProgressBar('comparisonBarsGrid', v1, v2, v1PctOfMax, v2PctOfMax);
            }
            
            document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
        }

        // Рендеринг баров для ОДНОГО варианта (Пункт 3)
        function renderSingleProgressBar(containerId, v1, plusPct, minusPct) {
            const grid = document.getElementById(containerId);
            grid.innerHTML = '';

            let totalWeights = v1.sumPlus + v1.sumMinus;
            let plusRatio = totalWeights > 0 ? (v1.sumPlus / totalWeights) * 100 : 100;
            let minusRatio = totalWeights > 0 ? (v1.sumMinus / totalWeights) * 100 : 0;

            let recText = '';
            if (selectedMethod === 'B') {
                if (v1.sumPlus > 0) {
                    let defectPercent = Math.round((v1.sumMinus / v1.sumPlus) * 100);
                    if (selectedStrategy === 'discount') {
                        // Стратегия Скидка
                        let suggestedDiscount = Math.floor(v1.price * (v1.sumMinus / (v1.sumPlus + v1.sumMinus)));
                        let targetPrice = v1.price - suggestedDiscount;
                        recText = `💡 <b>Обоснование скидки:</b> Минусы составляют <b>${defectPercent}%</b> от объёма плюсов. Рекомендуется запросить скидку соизмеримую влиянию негативных факторов в размере <b>${suggestedDiscount.toLocaleString('ru-RU')} руб.</b> (Целевая стоимость: <b>${targetPrice.toLocaleString('ru-RU')} руб.</b>).`;
                    } else {
                        // Стратегия Цена / Наценка
                        let suggestedPremium = Math.floor(v1.price * (v1.sumMinus / v1.sumPlus));
                        let targetPrice = v1.price + suggestedPremium;
                        recText = `💡 <b>Обоснование наценки:</b> Критерии минусов составляют <b>${defectPercent}%</b>. Чтобы полностью компенсировать или нивелировать эти риски/неудобства, целесообразно поднять бюджет или ценность предложения на <b>+${suggestedPremium.toLocaleString('ru-RU')} руб.</b> (Целевой эквивалент: <b>${targetPrice.toLocaleString('ru-RU')} руб.</b>).`;
                    }
                } else if(v1.sumMinus > 0) {
                    recText = `💡 Объект состоит только из минусов. Корректный пересчет пропорции невозможен.`;
                }
            }

            const wrapper = document.createElement('div');
            wrapper.className = 'bar-item-wrapper';
            wrapper.style.gridColumn = 'span 2'; // Растягиваем на всю ширину
            wrapper.innerHTML = `
                <div class="bar-label-row">
                    <span>${v1.name} (Соотношение внутренних сил)</span>
                </div>
                <div class="outer-progress-bar">
                    <div class="inner-relative-fill" style="width: 100%">
                        <div class="sub-bar-minus" style="width: ${minusRatio}%">
                            ${minusRatio > 8 ? `<span class="bar-text-left-minus">${v1.sumMinus}-</span>` : ''}
                        </div>
                        <div class="sub-bar-plus" style="width: ${plusRatio}%">
                            ${plusRatio > 8 ? `<span class="bar-text-left-plus">${v1.sumPlus}+</span>` : ''}
                        </div>
                    </div>
                    <div class="bar-score-overlay">${v1.baseBalance} баллов</div>
                </div>
                ${recText ? `<div class="bar-recommendation" style="margin-top: 8px; font-size: 0.85rem;">${recText}</div>` : ''}
            `;
            grid.appendChild(wrapper);
        }

        // Рендеринг баров для СРАВНЕНИЯ вариантов (Пункт 2 & 4)
        function renderComplexProgressBar(containerId, v1, v2, v1Pct, v2Pct) {
            const grid = document.getElementById(containerId);
            grid.innerHTML = '';

            const data = [
                { obj: v1, pct: v1Pct, key: 'v1' },
                { obj: v2, pct: v2Pct, key: 'v2' }
            ];

            // На последнем месте выигрышный вариант
            if (v1.finalScore > v2.finalScore) {
                data[0] = { obj: v2, pct: v2Pct, key: 'v2' };
                data[1] = { obj: v1, pct: v1Pct, key: 'v1' };
            }

            data.forEach(item => {
                const totalWeights = item.obj.sumPlus + item.obj.sumMinus;
                let plusRatio = totalWeights > 0 ? (item.obj.sumPlus / totalWeights) * 100 : 100;
                let minusRatio = totalWeights > 0 ? (item.obj.sumMinus / totalWeights) * 100 : 0;

                let recText = '';
                if (currentMode === 'compare' && v1.finalScore !== v2.finalScore) {
                    const competitor = (item.key === 'v1') ? v2 : v1;
                    if (item.obj.finalScore < competitor.finalScore) {
                        if (selectedMethod === 'B') {
                            if (selectedStrategy === 'discount') {
                                if (item.obj.baseBalance > 0) {
                                    let targetPrice = Math.floor((item.obj.baseBalance * 1000000) / competitor.finalScore);
                                    if (targetPrice > 0) {
                                        recText = `💡 Обоснование скидки: Если продавец снизит цену до <b>${targetPrice.toLocaleString('ru-RU')} руб.</b> или менее, этот вариант станет выгоднее!`;
                                    }
                                } else {
                                    recText = `💡 Баланс критериев отрицательный (${item.obj.baseBalance}). Снижение цены не сделает его выгодным.`;
                                }
                            } else {
                                // Прежняя логика Наценки
                                if (competitor.finalScore > 0 && item.obj.baseBalance > 0) {
                                    let targetPrice = Math.floor((competitor.finalScore * 100000) / item.obj.baseBalance);
                                    recText = `💡 Обоснование цены: Если поднять ценность/бюджет до <b>${targetPrice.toLocaleString('ru-RU')} руб.</b>, объект выиграет по эффективности наценки.`;
                                }
                            }
                        } else {
                            let weightDiff = competitor.finalScore - item.obj.finalScore;
                            recText = `💡 Наращивание преимуществ: Необходимо добавить ценности на <b>+${weightDiff + 1}</b> баллов, чтобы обойти конкурента.`;
                        }
                    }
                }

                const wrapper = document.createElement('div');
                wrapper.className = 'bar-item-wrapper';
                wrapper.innerHTML = `
                    <div class="bar-label-row">
                        <span>${item.obj.name}</span>
                    </div>
                    <div class="outer-progress-bar">
                        <div class="inner-relative-fill" style="width: ${item.pct}%">
                            <div class="sub-bar-minus" style="width: ${minusRatio}%">
                                ${minusRatio > 8 ? `<span class="bar-text-left-minus">${item.obj.sumMinus}-</span>` : ''}
                            </div>
                            <div class="sub-bar-plus" style="width: ${plusRatio}%">
                                ${plusRatio > 8 ? `<span class="bar-text-left-plus">${item.obj.sumPlus}+</span>` : ''}
                            </div>
                        </div>
                        <div class="bar-score-overlay">${formatScore(item.obj.finalScore, selectedMethod)} (итог: ${item.obj.baseBalance})</div>
                    </div>
                    ${recText ? `<div class="bar-recommendation">${recText}</div>` : ''}
                `;
                grid.appendChild(wrapper);
            });
        }

        function renderSummaryList(elementId, criteria) {
            const list = document.getElementById(elementId);
            list.innerHTML = '';
            
            if (criteria.length === 0) {
                list.innerHTML = '<li class="summary-item" style="color: var(--text-muted); justify-content: center;">Критерии отсутствуют</li>';
                return;
            }

            const sorted = [...criteria].sort((a, b) => {
                const valA = a.type === 'plus' ? a.weight : -a.weight;
                const valB = b.type === 'plus' ? b.weight : -b.weight;
                return valA - valB;
            });

            sorted.forEach(c => {
                const li = document.createElement('li');
                li.className = 'summary-item';
                li.innerHTML = `
                    <span>${c.name}</span>
                    <span class="badge ${c.type === 'plus' ? 'badge-plus' : 'badge-minus'}">
                        ${c.type === 'plus' ? '+' : '-'}${c.weight}
                    </span>
                `;
                list.appendChild(li);
            });
        }

        function copyToClipboard() {
            const globalMax = updateGlobalMaxWeight();
            const v1 = getVariantData('v1', globalMax);
            let text = `📊 *ОТЧЕТ АНАЛИЗАТОРА ПРИНЯТИЯ РЕШЕНИЙ*\n`;
            text += `===================================\n\n`;
            
            if (currentMode === 'single') {
                text += `👤 *Объект анализа:* ${v1.name}\n`;
                text += `📈 *Итоговый показатель ценности:* ${formatScore(v1.finalScore, v1.method)}\n`;
                text += `💵 *Выбранный алгоритм:* ${v1.method === 'A' ? 'Прямая сумма баллов' : 'Баллы / Цена'}\n`;
                if(v1.method === 'B') text += `⚙️ *Тип расчета:* ${v1.strategy === 'discount' ? 'Скидка' : 'Наценка'}\n`;
                text += `➕ *Сумма плюсов:* +${v1.sumPlus} | ➖ *Сумма минусов:* -${v1.sumMinus}\n`;
                text += `🎯 *Пиковый вес критерия:* ${globalMax}\n\n`;
                text += `📋 *СПИСОК АРГУМЕНТОВ:*\n`;
                
                const sorted = [...v1.criteria].sort((a,b) => (a.type==='plus'?a.weight:-a.weight) - (b.type==='plus'?b.weight:-b.weight));
                sorted.forEach((c, idx) => {
                    text += `  ${idx + 1}. ${c.type === 'plus' ? '🟢 [Плюс]' : '🔴 [Минус]'} ${c.name}: ${c.type === 'plus' ? '+' : '-'}${c.weight}\n`;
                });
            } else {
                const v2 = getVariantData('v2', globalMax);
                text += `⚖️ *СРАВНИТЕЛЬНЫЙ АНАЛИЗ ВАРИАНТОВ*\n\n`;
                text += `📌 *1. ${v1.name}*\n`;
                text += `   • Итоговая оценка: ${formatScore(v1.finalScore, v1.method)}\n`;
                text += `   • Чистый баланс: ${v1.baseBalance}\n`;
                if(selectedMethod==='B') text += `   • Заявленная цена: ${v1.price.toLocaleString('ru-RU')} руб.\n`;
                
                text += `\n📌 *2. ${v2.name}*\n`;
                text += `   • Итоговая оценка: ${formatScore(v2.finalScore, v2.method)}\n`;
                text += `   • Чистый баланс: ${v2.baseBalance}\n`;
                if(selectedMethod==='B') text += `   • Заявленная цена: ${v2.price.toLocaleString('ru-RU')} руб.\n\n`;
                
                let winnerName = 'Ничья';
                if(v1.finalScore > v2.finalScore) winnerName = v1.name;
                if(v2.finalScore > v1.finalScore) winnerName = v2.name;
                
                text += `🏆 *ОПТИМАЛЬНЫЙ ВАРИАНТ:* ${winnerName}\n`;
            }
            
            text += `\n_Сгенерировано автоматически в системе Анализатор._`;

            const el = document.createElement('textarea');
            el.value = text;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);

            const toast = document.getElementById('toast');
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2000);
        }

        function saveToStorage() {
            const globalMax = updateGlobalMaxWeight();
            const data = {
                currentMode,
                selectedMethod,
                selectedStrategy,
                v1Name: document.getElementById('v1Name').value,
                v2Name: document.getElementById('v2Name').value,
                v1Price: document.getElementById('v1Price').value,
                v2Price: document.getElementById('v2Price').value,
                v1Data: getVariantData('v1', globalMax).criteria,
                v2Data: getVariantData('v2', globalMax).criteria
            };
            localStorage.setItem('analyzer_backup_data', JSON.stringify(data));
        }

        function loadFromStorage() {
            const raw = localStorage.getItem('analyzer_backup_data');
            if (!raw) return false;
            try {
                const data = JSON.parse(raw);
                currentMode = data.currentMode || 'single';
                selectedMethod = data.selectedMethod || 'A';
                selectedStrategy = data.selectedStrategy || 'discount';
                
                document.getElementById('v1Name').value = data.v1Name || 'Вариант 1';
                document.getElementById('v2Name').value = data.v2Name || 'Вариант 2';
                document.getElementById('v1Price').value = data.v1Price || '2000000';
                document.getElementById('v2Price').value = data.v2Price || '2500000';

                document.getElementById('v1CriteriaList').innerHTML = '';
                if (data.v1Data && data.v1Data.length > 0) {
                    data.v1Data.forEach(c => addCriteriaRow('v1', c.name, c.type, c.weight));
                }
                
                document.getElementById('v2CriteriaList').innerHTML = '';
                if (data.v2Data && data.v2Data.length > 0) {
                    data.v2Data.forEach(c => addCriteriaRow('v2', c.name, c.type, c.weight));
                }

                setMode(currentMode);
                setCalculationMethod(selectedMethod);
                setStrategyMode(selectedStrategy);
                return true;
            } catch(e) {
                return false;
            }
        }

        function resetAll(clearComplete = false) {
            document.getElementById('v1CriteriaList').innerHTML = '';
            document.getElementById('v2CriteriaList').innerHTML = '';
            document.getElementById('resultsSection').style.display = 'none';
            
            if (clearComplete) {
                localStorage.removeItem('analyzer_backup_data');
            }
            
            addCriteriaRow('v1');
            addCriteriaRow('v2');
            updateGlobalMaxWeight();
        }

        document.getElementById('v1Name').addEventListener('input', saveToStorage);
        document.getElementById('v2Name').addEventListener('input', saveToStorage);
        document.getElementById('v1Price').addEventListener('input', saveToStorage);
        document.getElementById('v2Price').addEventListener('input', saveToStorage);

        window.onload = function() {
            createSnow();
            if (!loadFromStorage()) {
                resetAll(false);
            }
        };
    </script>
</body>
</html>
